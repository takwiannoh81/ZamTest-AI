# Copy to deploy/.env (or run ./init-env.sh, which also generates the secrets).
SITE_DOMAIN=zamtechai.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=

# Random secrets, at least 24 characters (openssl rand -hex 32)
ZAMTEST_ADMIN_TOKEN=
ZAMTEST_AGENT_KEY=

# AI features (optional)
ANTHROPIC_API_KEY=
ZAMTEST_AI_MODEL=

# Nightly encrypted backups to S3 (optional). Use a dedicated IAM user limited
# to this bucket; see deploy/backup-iam-policy.json and docs/DEPLOYMENT.md.
ZAMTEST_BACKUP_S3_BUCKET=
ZAMTEST_BACKUP_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
