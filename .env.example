# Orchestrator (Portal/Designer backend)
ZAMTEST_PORT=4000
ZAMTEST_HOST=127.0.0.1
ZAMTEST_DATA_DIR=.data
# Optional: require this bearer token for Portal/Designer API calls
ZAMTEST_ADMIN_TOKEN=
# Shared key bot agents use to connect (change this!)
ZAMTEST_AGENT_KEY=dev-agent-key

# AI features (selector suggestions, self-healing, workflow generation, AI agents)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
ZAMTEST_AI_MODEL=
